{
  "name": "ui-core-elements-templates",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/ui-core-elements-templates/src",
  "projectType": "library",
  "release": {
    "version": {
      "generatorOptions": {
        "packageRoot": "dist/{projectRoot}",
        "currentVersionResolver": "git-tag"
      }
    }
  },
  "tags": [],
  "implicitDependencies": [
    "ui-core-elements-atoms",
    "ui-core-elements-molecules",
    "ui-core-elements-organisms",
    "ui-core-styles"
  ],
  "targets": {
    "build": {
      "executor": "@nx/vite:build",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/ui-core-elements-templates",
        "main": "libs/ui-core-elements-templates/src/index.ts",
        "tsConfig": "libs/ui-core-elements-templates/tsconfig.lib.json",
        "assets": ["libs/ui-core-elements-templates/*.md"]
      }
    },
    "serve": {
      "executor": "@nx/vite:build",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/ui-core-elements-templates",
        "main": "libs/ui-core-elements-templates/src/index.ts",
        "tsConfig": "libs/ui-core-elements-templates/tsconfig.lib.json",
        "assets": ["libs/ui-core-elements-templates/*.md"],
        "watch": true
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    }
  }
}
