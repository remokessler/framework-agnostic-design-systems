{
  "name": "ui-core-styles",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/ui-core-styles/src",
  "prefix": "bui",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "options": {
        "main": "libs/ui-core-styles/src/index.ts",
        "tsConfig": "libs/ui-core-styles/tsconfig.lib.json",
        "outputPath": "dist/libs/ui-core-styles",
        "rootDir": "libs/ui-core-styles/src"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/ui-core-styles/tsconfig.lib.prod.json"
        },
        "development": {
          "tsConfig": "libs/ui-core-styles/tsconfig.lib.json"
        }
      },
      "defaultConfiguration": "production"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "libs/ui-core-styles/jest.config.ts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
